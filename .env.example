# PolyGuard v3.0 Backend Environment Variables
# IMPORTANT: This file is a TEMPLATE. Do NOT commit actual secrets to .env or the repository.
# Load sensitive values from environment variables or a secrets manager (e.g., AWS Secrets Manager, HashiCorp Vault).

# Server & Auth
SECRET_KEY=polyguard-v3-super-secret-jwt-key-change-in-production-minimum-32-chars
DEBUG=false
ENVIRONMENT=production

# Polygon RPC Nodes
POLYGON_MAINNET_RPC=https://polygon-rpc.com
POLYGON_ZKEVM_RPC=https://zkevm-rpc.com
POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology

# AI & Gemini API
# CRITICAL: DO NOT commit your actual API key here.
# Set this via environment variable in CI/CD or secrets manager in production.
GEMINI_API_KEY=

# Databases & Cache
DATABASE_URL=sqlite+aiosqlite:///./polyguard.db
REDIS_URL=redis://localhost:6379/0

# API Configuration
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","https://polyguard.ai.studio"]
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# RPC Proxy & MEV Protection
RPC_PROXY_ENABLED=true
RPC_PROXY_TIMEOUT_MS=15000
MEV_DETECTION_ENABLED=true

# Formal Verification & Security Tools
SLITHER_ENABLED=true
MYTHRIL_ENABLED=true
Z3_TIMEOUT_MS=5000

# Monitoring
PROMETHEUS_ENABLED=true
OTEL_ENABLED=false

# Security & Compliance
AML_CHECK_ENABLED=true
MICA_FRAMEWORK_ENABLED=true
ZK_PROOF_VERIFICATION=true
